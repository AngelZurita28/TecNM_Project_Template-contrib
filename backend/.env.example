# Docker usa .env de la raíz; Compose inyecta estas variables.
# Ejemplo opcional para ejecución manual con PostgreSQL propio.
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=tecnm_identity;Username=tecnm_app;Password=REPLACE_LOCAL_PASSWORD"
Jwt__SecretKey="REPLACE_WITH_AT_LEAST_32_RANDOM_UTF8_BYTES"
